# Enterprise
# The unique identifier for the enterprise tenant
ENT_TENANT_ID="<enterprise-tenant-id>"
# The unique identifier for the enterprise subscription
ENT_SUBSCRIPTION_ID="<enterprise-subscription-id>"
# The name of the resource group for enterprise resources
ENT_RESOURCE_GROUP="enterprise"

## Resources
# The name of the virtual network for enterprise resources
ENT_VNET_NAME="vnet-enterprise"
# The location of the enterprise resource group
ENT_RESOURCE_GROUP_LOCATION="Australia East"
# The name of the Azure Key Vault for enterprise resources
ENT_AKV_NAME="akv-fellipecm-enterprise"
# The name of the service principal for the enterprise function app
ENT_FUNCTION_APP_SPN_NAME="func-app-personal-spn"

####
# Personal tenant details
# The unique identifier for the personal tenant
PER_TENANT_ID="<personal-tenant-id>"
# The unique identifier for the personal subscription
PER_SUBSCRIPTION_ID="<personal-subscription-id>"
# The name of the resource group for personal resources
PER_RESOURCE_GROUP="personal"

## Resources
# The name of the virtual network for personal resources
PER_VNET_NAME="vnet-personal"
# The location of the personal resource group
PER_RESOURCE_GROUP_LOCATION="Australia East"
# The name of the personal function app
PER_FUNCTION_APP_NAME="func-app-personal"
